# Copie para .env somente se ele ainda não existir. Nunca versione .env.
DATABASE_URL="file:./dev.db"
# Gere: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
PDV_SESSION_SECRET=""
# false para localhost HTTP; true quando o endereço público usa HTTPS.
PDV_COOKIE_SECURE="false"
# Endereço público exato, sem / final, quando houver proxy/domínio. Vazio usa a origem da requisição.
APP_ORIGIN=""

# Provisionamento assistido (não são credenciais comparadas diretamente pelo login).
# Use um identificador estável para a loja; para funcionários, use o ID da empresa existente.
EMPRESA_ID=""
EMPRESA_NOME=""
ACCOUNT_NAME=""
ACCOUNT_LOGIN=""
ACCOUNT_PASSWORD=""
ACCOUNT_ROLE="ADMINISTRADOR"
# true somente para redefinir explicitamente senha, reativar vínculo e revogar sessões antigas.
ACCOUNT_RESET_EXISTING="false"

# Só para db:migrate:legacy: escolha explicitamente a empresa dona dos dados antigos.
MIGRATION_EMPRESA_ID=""
MIGRATION_EMPRESA_NOME=""
