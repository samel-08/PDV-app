# Copie para .env SOMENTE se ele ainda não existir. Não versione o .env.
DATABASE_URL="file:./dev.db"
# Login da instalação local (não representa um cliente separado).
PDV_LOGIN_USER="admin"
PDV_LOGIN_PASSWORD=""
# Gere com: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
PDV_SESSION_SECRET=""
# false para localhost HTTP; true somente ao usar HTTPS.
PDV_COOKIE_SECURE="false"
